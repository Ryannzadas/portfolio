# Token do GitHub (opcional, recomendado) — fine-grained, somente leitura de repositórios públicos.
# Sobe o limite da API de 60 para 5000 req/h e habilita a imagem de "social preview" personalizada.
GITHUB_TOKEN=

# ID do formulário no Formspree (a parte depois de /f/ na URL do formulário, ex: xyzabcde).
# Sem ele, o formulário abre o app de e-mail do visitante como fallback.
NEXT_PUBLIC_FORMSPREE_ID=

# URL pública do site (opcional — na Vercel é detectada automaticamente).
NEXT_PUBLIC_SITE_URL=
